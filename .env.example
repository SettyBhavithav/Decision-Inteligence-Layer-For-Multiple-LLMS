# LLM API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Mode
USE_SIMULATION=true

# Database Configurations
DATABASE_URL=sqlite:///metadata.db
CHROMA_DB_PATH=.chroma/

# Cache Config
REDIS_URL=redis://localhost:6379/0

# Decision Intelligence Layer Thresholds
THETA_ACCEPT=0.65
THETA_VERIFY=0.35

# Logging & Environment
ENV=development
LOG_LEVEL=INFO
PORT=8000
